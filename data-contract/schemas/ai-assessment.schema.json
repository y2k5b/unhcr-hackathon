{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Output distinti di answer engine e reasoning engine",
  "description": "Contratto v0.1 per dati dimostrativi sintetici. Le regole tra record sono in docs/02-regole-del-flusso.md.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "data_origin": {
      "const": "synthetic_demo"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]+$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]+$"
    },
    "interview_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]+$"
    },
    "input_snapshot_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "answer": {
      "type": "object",
      "properties": {
        "engine": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "simulated",
                "model_output"
              ]
            },
            "prompt_version": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "name",
            "version",
            "status",
            "prompt_version"
          ],
          "additionalProperties": false
        },
        "recommendation": {
          "enum": [
            "include",
            "exclude"
          ]
        },
        "predicted_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "vulnerability_band": {
          "enum": [
            "low",
            "moderate",
            "high",
            "severe",
            "unknown"
          ]
        },
        "uncertainty": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "not_available",
                "uncalibrated",
                "calibrated"
              ]
            },
            "probability_inclusion": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "calibration_reference": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "probability_inclusion",
            "calibration_reference",
            "note"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "engine",
        "recommendation",
        "predicted_score",
        "vulnerability_band",
        "uncertainty"
      ],
      "additionalProperties": false
    },
    "reasoning": {
      "type": "object",
      "properties": {
        "engine": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "simulated",
                "model_output"
              ]
            },
            "prompt_version": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "name",
            "version",
            "status",
            "prompt_version"
          ],
          "additionalProperties": false
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]+$"
          },
          "minItems": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "engine",
        "text",
        "evidence_ids",
        "limitations"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "data_origin",
    "id",
    "case_id",
    "interview_id",
    "input_snapshot_id",
    "generated_at",
    "answer",
    "reasoning"
  ],
  "additionalProperties": false
}
